<script>
(function(){
  var RED="#9A0000", INK="#141414", G1="#9E9E9E", G2="#CCCCCC", G3="#E6E6E6";
  var charts=[];
  function n0(v){ return new Intl.NumberFormat("es-AR",{maximumFractionDigits:0}).format(v); }
  function ars(v){ return "$"+n0(v); }

  if(typeof Chart === "undefined"){ return; }
  Chart.defaults.font.family = "Montserrat, sans-serif";
  Chart.defaults.font.size = 11;
  Chart.defaults.color = INK;
  function mk(id,cfg){ var c=new Chart(document.getElementById(id),cfg); charts.push(c); return c; }
  var leg={position:"bottom", labels:{boxWidth:10,boxHeight:10,padding:12}};

  mk("chMes",{
    data:{labels:["Agosto","Septiembre"],datasets:[
      {type:"bar",label:"Generación de leads",data:[603593,850906],backgroundColor:RED,yAxisID:"y",borderRadius:0,stack:"inv"},
      {type:"bar",label:"Contenido de marca",data:[276157,537992],backgroundColor:G1,yAxisID:"y",borderRadius:0,stack:"inv"},
      {type:"bar",label:"Tráfico al sitio",data:[129863,0],backgroundColor:G2,yAxisID:"y",borderRadius:0,stack:"inv"},
      {type:"line",label:"Leads",data:[99,93],borderColor:INK,backgroundColor:INK,yAxisID:"y1",tension:.3,pointRadius:5,borderWidth:2.5}]},
    options:{responsive:true,maintainAspectRatio:false,interaction:{mode:"index",intersect:false},
      plugins:{legend:leg,tooltip:{callbacks:{label:function(c){return c.dataset.label+": "+(c.dataset.type==="line"?n0(c.parsed.y)+" leads":ars(c.parsed.y));}}}},
      scales:{y:{stacked:true,position:"left",grid:{color:"#F0F0F0"},ticks:{callback:function(v){return "$"+(v/1000000).toFixed(1)+"M";}}},
        y1:{position:"right",beginAtZero:true,suggestedMax:120,grid:{drawOnChartArea:false},ticks:{callback:function(v){return n0(v);}}},
        x:{stacked:true,grid:{display:false}}}}
  });

  mk("chCpl",{type:"bar",
    data:{labels:["Junio","Julio","Agosto","Septiembre"],datasets:[{label:"Costo por lead",data:[4427,5523,6097,9150],backgroundColor:[G3,G2,G1,RED],borderRadius:0}]},
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{display:false},tooltip:{callbacks:{label:function(c){return "Costo por lead: "+ars(c.parsed.y);}}}},
      scales:{y:{beginAtZero:true,grid:{color:"#F0F0F0"},ticks:{callback:function(v){return "$"+n0(v);}}},x:{grid:{display:false}}}}
  });

})();
</script>
